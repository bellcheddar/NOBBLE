# Copy to .env and fill in. .env is gitignored and never committed.
# The deploy script fails loudly rather than guessing any of these.

# The droplet. Use the SAME host string everywhere: host keys are per host
# string, so a key trusted for mdeller.com does not cover the bare IP, and a
# non-interactive rsync cannot answer a trust prompt.
DROPLET_SSH=root@mdeller.com

# Claude Code has no SSH_AUTH_SOCK, so an agent-based default key will not work:
# the key must be named explicitly.
SSH_KEY=~/.ssh/faffabout_deploy

# Where the app lives on the droplet, and the service that runs it.
REMOTE_DIR=/srv/nobble
SERVICE=nobble
SERVICE_USER=www-data

# Public hostname, used by the post-deploy page checks.
PUBLIC_HOST=https://nobble.mdeller.com
